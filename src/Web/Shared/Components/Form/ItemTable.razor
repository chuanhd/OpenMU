@typeparam TItem

@using MUnique.OpenMU.Persistence
@using System.Text.RegularExpressions
@inherits InputBase<ICollection<TItem>>

@inject IModalService _modal
@inject NavigationManager _navigationManager

    <div class="card mb-3">
        <h5 class="card-header d-flex align-items-center justify-content-between gap-2">
            <FieldLabel Text="@Label" ValueExpression="@this.ValueExpression" />
            @if (this._isStartingCollapsed)
            {
                @if (this._isCollapsed)
                {
                    <button type="button" class="btn btn-outline-info btn-sm text-nowrap" @onclick="@this.OnToggleCollapseClick">Expand (@(this.Value?.Count) Items)</button>
                }
                else
                {
                    <button type="button" class="btn btn-outline-info btn-sm text-nowrap" @onclick="@this.OnToggleCollapseClick">Collapse</button>
                }
            }
        </h5>
        @if (!this._isCollapsed)
        {
            <div class="card-body card-text">
                @if (this._showSearch)
                {
                    <div class="auto-form-container">
                        <div class="mb-3 auto-form-search-group">
                            <input type="text"
                                   class="form-control"
                                   placeholder="@($"{Resources.Search}...")"
                                   @bind="this._searchTerm"
                                   @bind:event="oninput" />
                            <span class="oi oi-magnifying-glass search-icon"></span>
                        </div>
                    </div>
                }
                <table class="table table-striped table-hover">
                    <tbody>
                    @foreach (var item in this.OrderedFilteredItems)
                    {
                        <tr>
                        @if (this._isInlineEditable)
                        {
                            <td colspan="2" class="align-top">
                                <EditForm Model="@item.Item"><AutoFields></AutoFields></EditForm>
                            </td>
                        }
                        else
                        {
                            <td class="align-middle">
                                @item.Name
                            </td>
                            <td class="align-middle text-end text-nowrap">
                                @if (this._isEditable)
                                {
                                    string urlPrefix;
                                    if (typeof(TItem).IsConfigurationType())
                                    {
                                        urlPrefix = "edit-config";
                                    }
                                    else if (Regex.Match(this._navigationManager.Uri, @"\/edit-(.*)\/(.+)?\/M") is { Success: true } match)
                                    {
                                        urlPrefix = $"edit-{match.Groups[1]}/{match.Groups[2]}";
                                    }
                                    else if (Regex.Match(this._navigationManager.Uri, @"\/edit-(.*)?\/M") is { Success: true } matchConfig)
                                    {
                                        urlPrefix = $"edit-{matchConfig.Groups[1]}";
                                    }
                                    else
                                    {
                                        urlPrefix = "edit-account";
                                    }

                                    <a href="@($"{urlPrefix}/{typeof(TItem).FullName}/{item.Id}")" class="btn btn-primary btn-sm text-nowrap"><span class="oi oi-pencil" aria-hidden="true"></span> Edit</a>
                                }
                            </td>
                        }
                            <td class="align-top text-end text-nowrap">
                                @if (this._isEditable)
                                {
                                    <button type="button" class="btn btn-danger btn-sm text-nowrap" @onclick="@(() => OnRemoveClickAsync(item.Item))"><span class="oi oi-trash" aria-hidden="true"></span> Remove</button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="border-bottom-0">
                                <div class="d-flex justify-content-end gap-2">
                                @if (this._isAddingSupported)
                                {
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="@OnAddClickAsync">Add</button>
                                }

                                @if (this._isCreatingSupported)
                                {
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="@OnCreateClickAsync">Create</button>
                                }
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
